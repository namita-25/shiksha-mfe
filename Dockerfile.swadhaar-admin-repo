FROM node:20-slim AS builder

WORKDIR /workspace

ENV NODE_OPTIONS="--max-old-space-size=8192"
ENV CYPRESS_INSTALL_BINARY=0
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV npm_config_cache="/tmp/.npm"

# Copy package manifests
COPY package*.json ./

# Install PM2 and dependencies using locked versions with scripts ignored
RUN npm install -g pm2@6.0.8 --ignore-scripts && \
    npm ci --legacy-peer-deps --no-audit --no-fund --ignore-scripts && \
    npm cache clean --force

# Copy application sources (filtered by .dockerignore to prevent including sensitive files)
COPY . .

# Run patch script if present, build application, cleanup build caches, and configure non-root user permissions
RUN if [ -f patch-nx.js ]; then node patch-nx.js; fi && \
    ./node_modules/.bin/nx build swadhaar-admin-repo && \
    rm -rf apps/swadhaar-admin-repo/.next/cache \
           .nx/cache \
           /tmp/.npm && \
    chown -R node:node /workspace

# Switch to non-root user provided by node base image
USER node

EXPOSE 3004

CMD ["pm2-runtime", "ecosystem.swadhaar-admin-repo.config.js"]
