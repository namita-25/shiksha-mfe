FROM node:20-slim AS builder

WORKDIR /workspace

ENV NODE_OPTIONS="--max-old-space-size=8192"
ENV CYPRESS_INSTALL_BINARY=0
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV npm_config_cache="/tmp/.npm"

COPY package*.json ./

RUN npm install --legacy-peer-deps --no-audit --no-fund --ignore-scripts

COPY . .

# Run patch script for Nx lockfile parser bug if present
RUN if [ -f patch-nx.js ]; then node patch-nx.js; fi

# Build Swadhaar Admin application (Standalone - no workspace or player MFEs needed)
RUN npx nx build swadhaar-admin-repo

# Cleanup build caches
RUN rm -rf apps/swadhaar-admin-repo/.next/cache \
           .nx/cache \
           /tmp/.npm

# Install PM2
RUN npm install -g pm2@6.0.8 && npm cache clean --force

EXPOSE 3004

CMD ["pm2-runtime", "ecosystem.swadhaar-admin-repo.config.js"]
